# Copia este archivo a .env y completa tus valores (NUNCA subas .env a GitHub)
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/catalogo
# Pon true si tu proveedor exige SSL (Neon, Render, Supabase)
DB_SSL=false

# Secreto para firmar JWT: mínimo 32 caracteres aleatorios
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Datos para el script que crea el administrador (npm run admin:crear)
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@catalogo.test
ADMIN_PASSWORD=
